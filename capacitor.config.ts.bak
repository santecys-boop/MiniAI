import type { CapacitorConfig } from '@capacitor/cli';

const config: CapacitorConfig = {
  appId: 'com.mini.app',
  appName: 'Mini',
  webDir: 'dist',
  android: {
    allowMixedContent: true,
  }
};

export default config;
// Android mikrofon ayarı
if (typeof config.android === 'object') {
  (config.android as any).allowPermissions = true;
}
