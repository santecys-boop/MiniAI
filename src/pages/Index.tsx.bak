import { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";
import { useSystemAnalyzer } from "@/hooks/useSystemAnalyzer";
import { useAI } from "@/hooks/useAI";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Sparkles, Wifi, WifiOff, Cpu, Zap, Cloud, Smartphone, LogOut, Activity, Battery, HardDrive, Brain, CheckCircle, ArrowRight, ChevronDown, ChevronUp, Download, Loader2 } from "lucide-react";

export default function Index() {
  const navigate = useNavigate();
  const { systemInfo, score, loading: analyzing } = useSystemAnalyzer();
  const { models, bestModel, reason, loading: aiLoading, selectBest } = useAI();
  const [selectedMode, setSelectedMode] = useState<'online' | 'offline' | null>(null);
  const [showAnalysis, setShowAnalysis] = useState(false);
  const [showModels, setShowModels] = useState(false);
  const [autoSelected, setAutoSelected] = useState(false);

  useEffect(() => {
    if (!localStorage.getItem("mini-auth")) navigate("/auth");
  }, []);

  // Sistem analizi bitince otomatik model seç
  useEffect(() => {
    if (score && !autoSelected) {
      const ramMB = score.ramGB * 1024;
      selectBest(ramMB, score.cores, score.hasNPU);
      setAutoSelected(true);
    }
  }, [score, autoSelected]);

  function handleLogout() {
    localStorage.removeItem("mini-auth");
    navigate("/auth");
  }

  const isOnline = navigator.onLine;

  if (analyzing || aiLoading) {
    return (
      <div className="min-h-screen bg-[#030308] flex items-center justify-center">
        <div className="text-center space-y-6">
          <div className="relative inline-block">
            <div className="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full blur-2xl opacity-50 animate-pulse" />
            <div className="relative flex items-center justify-center">
              <Activity className="w-20 h-20 text-blue-400 animate-spin" />
              <Brain className="absolute w-10 h-10 text-purple-400" />
            </div>
          </div>
          <div className="space-y-2">
            <h2 className="text-2xl text-white/80 font-bold">
              {analyzing ? "Sistem Analiz Ediliyor..." : "AI Modeli Seçiliyor..."}
            </h2>
            <p className="text-white/40 text-sm max-w-xs mx-auto">
              {analyzing 
                ? "Cihazının donanımı kontrol ediliyor, en uygun AI modeli belirleniyor" 
                : "Sistemine en uygun model otomatik seçiliyor"}
            </p>
          </div>
          {/* Progress dots */}
          <div className="flex gap-2 justify-center">
            {[0, 1, 2].map((i) => (
              <div key={i} className="w-2 h-2 rounded-full bg-blue-400/60 animate-pulse" style={{ animationDelay: `${i * 0.2}s` }} />
            ))}
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#030308] text-white">
      {/* Arka plan */}
      <div className="fixed inset-0 pointer-events-none">
        <div className="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] bg-gradient-to-br from-blue-600/20 to-transparent rounded-full blur-[120px]" />
        <div className="absolute bottom-[-10%] right-[-5%] w-[500px] h-[500px] bg-gradient-to-tl from-purple-600/20 to-transparent rounded-full blur-[100px]" />
        <div className="absolute top-[40%] left-[50%] -translate-x-1/2 w-[400px] h-[400px] bg-gradient-to-r from-cyan-500/10 to-transparent rounded-full blur-[80px]" />
      </div>

      {/* Header */}
      <header className="relative z-10 flex items-center justify-between px-6 py-4 border-b border-white/5">
        <div className="flex items-center gap-3">
          <div className="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-lg">
            <Sparkles className="w-5 h-5 text-white" />
          </div>
          <span className="font-bold text-lg">MİNİ-AI</span>
        </div>
        <div className="flex items-center gap-3">
          {score && (
            <span className="text-sm text-white/50 bg-white/5 px-3 py-1 rounded-full border border-white/10">
              AI Skor: {Math.round(score.score)}/100
            </span>
          )}
          <Button variant="ghost" size="sm" onClick={handleLogout} className="text-white/60 hover:text-white hover:bg-white/5 rounded-full">
            <LogOut className="w-4 h-4" />
          </Button>
        </div>
      </header>

      <main className="relative z-10 max-w-4xl mx-auto px-4 py-8 space-y-6">
        
        {/* Başlık */}
        <div className="text-center space-y-2">
          <h1 className="text-3xl font-bold">AI Modunu Seç</h1>
          <p className="text-white/40">Sistem analizine göre en iyi deneyim</p>
        </div>

        {/* Sistem Analizi + Otomatik Model Önerisi */}
        {score && bestModel && (
          <Card className="bg-gradient-to-br from-emerald-500/5 to-cyan-500/5 border border-emerald-500/20 rounded-2xl p-5 backdrop-blur-sm">
            <div className="flex items-start gap-4">
              <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/20 to-cyan-500/20 flex items-center justify-center flex-shrink-0">
                <CheckCircle className="w-6 h-6 text-emerald-400" />
              </div>
              <div className="flex-1">
                <h3 className="font-bold text-lg text-emerald-300">✅ Otomatik Model Seçildi!</h3>
                <p className="text-white/60 text-sm mt-1">{reason}</p>
                <div className="mt-3 flex items-center gap-2 bg-white/5 rounded-xl px-4 py-2.5 border border-white/10">
                  <Brain className="w-5 h-5 text-purple-400" />
                  <span className="font-semibold text-white/90">{bestModel}</span>
                  <Download className="w-4 h-4 text-white/30 ml-auto" />
                </div>
              </div>
            </div>
          </Card>
        )}

        {/* Sistem Detayları */}
        {score && (
          <Card className="bg-white/[0.02] border border-white/5 rounded-2xl p-4">
            <div className="flex items-center justify-between cursor-pointer" onClick={() => setShowAnalysis(!showAnalysis)}>
              <div className="flex items-center gap-3">
                <Cpu className="w-5 h-5 text-blue-400" />
                <span className="text-sm font-medium">Sistem Detayları</span>
              </div>
              <div className="flex items-center gap-3">
                <span className={`text-xs px-2 py-0.5 rounded-full ${
                  score.level === 'ultra' ? 'bg-emerald-500/20 text-emerald-400' :
                  score.level === 'high' ? 'bg-blue-500/20 text-blue-400' :
                  'bg-amber-500/20 text-amber-400'
                }`}>
                  {score.level === 'ultra' ? '🚀 Ultra' : score.level === 'high' ? '⚡ Yüksek' : '👍 Orta'}
                </span>
                {showAnalysis ? <ChevronUp className="w-4 h-4 text-white/30" /> : <ChevronDown className="w-4 h-4 text-white/30" />}
              </div>
            </div>
            {showAnalysis && (
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 pt-4 border-t border-white/5">
                <div className="bg-white/[0.02] rounded-xl p-3 text-center">
                  <Battery className="w-4 h-4 text-cyan-400 mx-auto mb-1" />
                  <p className="text-xs text-white/40">RAM</p>
                  <p className="text-sm font-medium">{score.ramGB} GB</p>
                </div>
                <div className="bg-white/[0.02] rounded-xl p-3 text-center">
                  <Cpu className="w-4 h-4 text-purple-400 mx-auto mb-1" />
                  <p className="text-xs text-white/40">CPU</p>
                  <p className="text-sm font-medium">{score.cores} Çekirdek</p>
                </div>
                <div className="bg-white/[0.02] rounded-xl p-3 text-center">
                  <HardDrive className="w-4 h-4 text-amber-400 mx-auto mb-1" />
                  <p className="text-xs text-white/40">NPU</p>
                  <p className="text-sm font-medium">{score.hasNPU ? '✅ Var' : '❌ Yok'}</p>
                </div>
                <div className="bg-white/[0.02] rounded-xl p-3 text-center">
                  <Activity className="w-4 h-4 text-rose-400 mx-auto mb-1" />
                  <p className="text-xs text-white/40">Skor</p>
                  <p className="text-sm font-medium">{Math.round(score.score)}/100</p>
                </div>
              </div>
            )}
          </Card>
        )}

        {/* AI Mod Seçimi */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {/* Online AI */}
          <Card 
            className={`relative overflow-hidden rounded-2xl border transition-all duration-300 cursor-pointer group ${
              selectedMode === 'online' 
                ? 'border-blue-500/50 bg-blue-500/5 shadow-[0_0_30px_rgba(59,130,246,0.2)]' 
                : 'border-white/10 bg-white/[0.01] hover:border-blue-500/30'
            } ${!isOnline ? 'opacity-50' : ''}`}
            onClick={() => isOnline && setSelectedMode('online')}
          >
            {!isOnline && (
              <div className="absolute top-3 right-3 bg-rose-500/20 text-rose-300 text-xs px-2 py-1 rounded-full flex items-center gap-1">
                <WifiOff className="w-3 h-3" /> İnternet Yok
              </div>
            )}
            <div className="p-6 space-y-4">
              <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-cyan-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
                <Cloud className="w-7 h-7 text-blue-400" />
              </div>
              <div>
                <h3 className="text-xl font-bold flex items-center gap-2"><Wifi className="w-5 h-5 text-blue-400" /> Online AI</h3>
                <p className="text-white/50 text-sm mt-1">En güçlü modeller, anında yanıt</p>
              </div>
              <div className="space-y-2">
                {['Sınırsız bilgi', 'En güncel AI', 'Hızlı yanıt', 'Tüm özellikler'].map((f, i) => (
                  <div key={i} className="flex items-center gap-2 text-xs text-white/60"><Zap className="w-3 h-3 text-blue-400" /> {f}</div>
                ))}
              </div>
              <Button className="w-full rounded-xl bg-gradient-to-r from-blue-500 to-cyan-500" disabled={!isOnline}>
                <Wifi className="w-4 h-4 mr-2" /> Online Başla
              </Button>
            </div>
          </Card>

          {/* Offline AI */}
          <Card 
            className={`relative overflow-hidden rounded-2xl border transition-all duration-300 cursor-pointer group ${
              selectedMode === 'offline'
                ? 'border-purple-500/50 bg-purple-500/5 shadow-[0_0_30px_rgba(147,51,234,0.2)]'
                : 'border-white/10 bg-white/[0.01] hover:border-purple-500/30'
            }`}
            onClick={() => setSelectedMode('offline')}
          >
            <div className="p-6 space-y-4">
              <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-500/20 to-pink-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
                <Smartphone className="w-7 h-7 text-purple-400" />
              </div>
              <div>
                <h3 className="text-xl font-bold flex items-center gap-2"><WifiOff className="w-5 h-5 text-purple-400" /> Offline AI</h3>
                <p className="text-white/50 text-sm mt-1">Cihazında çalışır, internet yok</p>
              </div>
              <div className="space-y-2">
                {['Tamamen gizli', 'İnternetsiz', 'Düşük gecikme', 'Pil tasarrufu'].map((f, i) => (
                  <div key={i} className="flex items-center gap-2 text-xs text-white/60"><Zap className="w-3 h-3 text-purple-400" /> {f}</div>
                ))}
              </div>
              <Button className="w-full rounded-xl bg-gradient-to-r from-purple-500 to-pink-500">
                <WifiOff className="w-4 h-4 mr-2" /> Offline Başla
              </Button>
            </div>
          </Card>
        </div>

        {/* Model Listesi */}
        {models.length > 0 && (
          <Card className="bg-white/[0.02] border border-white/5 rounded-2xl p-4">
            <div className="flex items-center justify-between cursor-pointer" onClick={() => setShowModels(!showModels)}>
              <div className="flex items-center gap-3">
                <Brain className="w-5 h-5 text-purple-400" />
                <span className="text-sm font-medium">Kullanılabilir AI Modelleri ({models.length})</span>
              </div>
              {showModels ? <ChevronUp className="w-4 h-4 text-white/30" /> : <ChevronDown className="w-4 h-4 text-white/30" />}
            </div>
            {showModels && (
              <div className="mt-4 space-y-2">
                {models.map((model, i) => (
                  <div key={i} className={`p-3 rounded-xl text-xs ${
                    bestModel && model.includes(bestModel.replace(' (NPU Hızlandırmalı)', ''))
                      ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-300'
                      : 'bg-white/[0.01] border border-white/5 text-white/50'
                  }`}>
                    {bestModel && model.includes(bestModel.replace(' (NPU Hızlandırmalı)', '')) && (
                      <span className="text-emerald-400 font-bold mr-1">✅ ÖNERİLEN:</span>
                    )}
                    {model}
                  </div>
                ))}
              </div>
            )}
          </Card>
        )}

        {/* Başla Butonu */}
        {selectedMode && (
          <div className="text-center animate-in fade-in slide-in-from-bottom-4 duration-500">
            <Button size="lg" className="rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 shadow-lg px-12 py-6 text-lg">
              🚀 {selectedMode === 'online' ? 'Online AI ile Başla!' : 'Offline AI ile Başla!'}
            </Button>
          </div>
        )}
      </main>

      <footer className="relative z-10 text-center py-6 text-white/15 text-xs">
        Ahmet Avcı · MİNİ-AI · v1.0
      </footer>
    </div>
  );
}
